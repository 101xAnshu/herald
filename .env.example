NODE_ENV=development
PORT=3000
API_WORKERS=4

DATABASE_URL=postgresql://herald:herald@localhost:5433/herald
DB_POOL_MAX=30
SHARD_COUNT=1
SHARD_DATABASE_URLS=

REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092
KAFKA_PARTITIONS=6
WORKER_ROLES=relay,orchestrator,delivery,scheduler,reconciler,campaign,retention

SMTP_URL=smtp://localhost:1025
MAILPIT_URL=http://localhost:8025
WEBHOOK_SECRET=local-development-webhook-secret

JWT_SECRET=local-development-jwt-secret
API_KEY_PEPPER=local-development-api-key-pepper
DEMO_MODE=true
ALLOW_CRITICAL_WHEN_PAUSED=true

LOG_LEVEL=info
CAMPAIGN_BATCH_SIZE=100
CAMPAIGN_RATE_LIMIT=50
INBOX_RETENTION_DAYS=30
OUTBOX_MAX_PENDING_ROWS=100000
OUTBOX_MAX_AGE_SECONDS=300
