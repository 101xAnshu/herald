NODE_ENV=development
PORT=3000
# Two workers for the full pipeline. Use 4 for the ingest-only ceiling.
API_WORKERS=2

DATABASE_URL=postgresql://herald:herald@localhost:5433/herald
DB_POOL_MAX=15
WORKER_DB_POOL_MAX=10
DELIVERY_DB_POOL_MAX=10
# Delivery replicas. Each opens DELIVERY_DB_POOL_MAX connections.
DELIVERY_WORKERS=3
PROVIDER_RATE_LIMIT=600
CONSUMER_CONCURRENCY=16
SHARD_COUNT=1
SHARD_DATABASE_URLS=

REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092
KAFKA_PARTITIONS=24
# Compose overrides this per service. A single local process runs every role.
WORKER_ROLES=relay,orchestrator,delivery,scheduler,reconciler,campaign,retention

SMTP_URL=smtp://localhost:1025
MAILPIT_URL=http://localhost:8025
WEBHOOK_SECRET=local-development-webhook-secret

JWT_SECRET=local-development-jwt-secret
API_KEY_PEPPER=local-development-api-key-pepper
DEMO_MODE=true
ALLOW_CRITICAL_WHEN_PAUSED=true

LOG_LEVEL=info
CAMPAIGN_BATCH_SIZE=100
CAMPAIGN_RATE_LIMIT=50
INBOX_RETENTION_DAYS=30
OUTBOX_MAX_PENDING_ROWS=100000
OUTBOX_MAX_AGE_SECONDS=300
