generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Source {
  BOOKING  @map("booking")
  PAYMENTS @map("payments")
  SECURITY @map("security")
  GROWTH   @map("growth")
  OPS      @map("ops")

  @@map("source")
}

enum Channel {
  EMAIL   @map("email")
  IN_APP  @map("in_app")
  PUSH    @map("push")
  SMS     @map("sms")

  @@map("channel")
}

enum Priority {
  CRITICAL @map("critical")
  HIGH     @map("high")
  NORMAL   @map("normal")
  LOW      @map("low")

  @@map("priority")
}

enum NotificationStatus {
  ACCEPTED            @map("accepted")
  SCHEDULED           @map("scheduled")
  PROCESSING          @map("processing")
  PARTIALLY_DELIVERED @map("partially_delivered")
  DELIVERED           @map("delivered")
  FAILED              @map("failed")
  CANCELED            @map("canceled")
  SUPPRESSED          @map("suppressed")

  @@map("notification_status")
}

enum DeliveryStatus {
  PENDING         @map("pending")
  SENDING         @map("sending")
  ACCEPTED        @map("accepted")
  DELIVERED       @map("delivered")
  RETRY_SCHEDULED @map("retry_scheduled")
  UNKNOWN         @map("unknown")
  FAILED          @map("failed")
  CANCELED        @map("canceled")
  SUPPRESSED      @map("suppressed")

  @@map("delivery_status")
}

enum CampaignStatus {
  DRAFT     @map("draft")
  SCHEDULED @map("scheduled")
  RUNNING   @map("running")
  PAUSED    @map("paused")
  COMPLETED @map("completed")
  CANCELED  @map("canceled")
  FAILED    @map("failed")

  @@map("campaign_status")
}

enum CampaignRecipientStatus {
  PENDING    @map("pending")
  QUEUED     @map("queued")
  SENT       @map("sent")
  DELIVERED  @map("delivered")
  FAILED     @map("failed")
  SUPPRESSED @map("suppressed")
  CANCELED   @map("canceled")

  @@map("campaign_recipient_status")
}

enum ErrorClass {
  PERMANENT         @map("permanent")
  TRANSIENT         @map("transient")
  RATE_LIMIT        @map("rate_limit")
  UNKNOWN           @map("unknown")
  AUTH              @map("auth")
  INVALID_RECIPIENT @map("invalid_recipient")
  SUPPRESSED        @map("suppressed")

  @@map("error_class")
}

enum RetryState {
  PENDING   @map("pending")
  CLAIMED   @map("claimed")
  SUCCEEDED @map("succeeded")
  EXHAUSTED @map("exhausted")
  CANCELED  @map("canceled")

  @@map("retry_state")
}

enum ApiClientKind {
  SERVICE  @map("service")
  OPERATOR @map("operator")

  @@map("api_client_kind")
}

enum UserKind {
  CUSTOMER @map("customer")
  PRO      @map("pro")
  OPS      @map("ops")

  @@map("user_kind")
}

enum UserStatus {
  ACTIVE   @map("active")
  DISABLED @map("disabled")

  @@map("user_status")
}

enum DevicePlatform {
  IOS     @map("ios")
  ANDROID @map("android")
  WEB     @map("web")

  @@map("device_platform")
}

enum DeviceStatus {
  ACTIVE      @map("active")
  INVALIDATED @map("invalidated")

  @@map("device_status")
}

enum ConsentAction {
  GRANTED @map("granted")
  REVOKED @map("revoked")

  @@map("consent_action")
}

enum TemplateStatus {
  DRAFT     @map("draft")
  PUBLISHED @map("published")
  ARCHIVED  @map("archived")

  @@map("template_status")
}

enum EventTypeStatus {
  ACTIVE   @map("active")
  DISABLED @map("disabled")

  @@map("event_type_status")
}

enum OutboxStatus {
  PENDING   @map("pending")
  PUBLISHED @map("published")
  FAILED    @map("failed")

  @@map("outbox_status")
}

enum AuditResult {
  SUCCESS @map("success")
  FAILURE @map("failure")

  @@map("audit_result")
}

model ApiClient {
  id            String        @id
  source        Source
  kind          ApiClientKind @default(SERVICE)
  name          String
  keyPrefix     String        @unique @map("key_prefix")
  keyHash       String        @map("key_hash")
  scopes        String[]
  lastUsedAt    DateTime?     @map("last_used_at")
  expiresAt     DateTime?     @map("expires_at")
  revokedAt     DateTime?     @map("revoked_at")
  rotatedFromId String?       @map("rotated_from_id")
  createdBy     String        @map("created_by")
  createdAt     DateTime      @default(now()) @map("created_at")

  @@index([source])
  @@map("api_clients")
}

model SourceControl {
  source    Source   @id
  paused    Boolean  @default(false)
  pausedAt  DateTime? @map("paused_at")
  pausedBy  String?   @map("paused_by")
  reason    String?
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("source_controls")
}

model User {
  id            String          @id
  externalId    String          @unique @map("external_id")
  kind          UserKind
  email         String?
  phone         String?
  displayName   String?         @map("display_name")
  locale        String          @default("en-IN")
  timezone      String          @default("Asia/Kolkata")
  status        UserStatus      @default(ACTIVE)
  city          String?
  lastBookingAt DateTime?       @map("last_booking_at")
  attributes    Json            @default("{}")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  preferences        Preference[]
  settings           UserSettings?
  devices            Device[]
  consentEvents      ConsentEvent[]
  notifications      Notification[]
  deliveries         Delivery[]
  inboxItems         InboxItem[]
  campaignRecipients CampaignRecipient[]

  @@index([city, lastBookingAt], map: "users_city_last_booking_idx")
  @@index([kind])
  @@map("users")
}

model Device {
  id            String         @id
  userId        String         @map("user_id")
  platform      DevicePlatform
  tokenHash     String         @unique @map("token_hash")
  status        DeviceStatus   @default(ACTIVE)
  lastSeenAt    DateTime?      @map("last_seen_at")
  invalidatedAt DateTime?      @map("invalidated_at")
  createdAt     DateTime       @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("devices")
}

model Preference {
  userId    String   @map("user_id")
  category  String
  channel   Channel
  enabled   Boolean
  source    Source
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, category, channel])
  @@index([category, channel])
  @@map("preferences")
}

model UserSettings {
  userId          String   @id @map("user_id")
  quietStart      String?  @map("quiet_start")
  quietEnd        String?  @map("quiet_end")
  marketingPaused Boolean  @default(false) @map("marketing_paused")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model ConsentEvent {
  id         String        @id
  userId     String        @map("user_id")
  category   String
  channel    Channel
  action     ConsentAction
  source     Source
  occurredAt DateTime      @default(now()) @map("occurred_at")
  ipHash     String?       @map("ip_hash")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt(sort: Desc)])
  @@map("consent_events")
}

model SuppressionList {
  id          String    @id
  channel     Channel
  addressHash String    @map("address_hash")
  reason      String
  provider    String?
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([channel, addressHash])
  @@map("suppression_list")
}

model EventType {
  id                  String          @id
  key                 String
  schema              Json            @default("{}")
  defaultPriority     Priority        @map("default_priority")
  policy              Json            @default("{}")
  allowedChannels     Channel[]       @map("allowed_channels")
  allowedSources      Source[]        @map("allowed_sources")
  dedupeWindowSeconds Int             @map("dedupe_window_seconds")
  status              EventTypeStatus @default(ACTIVE)
  version             Int             @default(1)
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  @@unique([key, version])
  @@index([key, status])
  @@map("event_types")
}

model Template {
  id               String         @id
  key              String
  channel          Channel
  locale           String
  name             String
  status           TemplateStatus @default(DRAFT)
  currentVersionId String?        @unique @map("current_version_id")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  versions         TemplateVersion[] @relation("TemplateVersions")
  currentVersion   TemplateVersion?  @relation("CurrentTemplateVersion", fields: [currentVersionId], references: [id])
  campaigns        Campaign[]

  @@unique([key, channel, locale])
  @@index([key, locale])
  @@map("templates")
}

model TemplateVersion {
  id             String    @id
  templateId     String    @map("template_id")
  version        Int
  subject        String?
  html           String
  text           String
  variablesSchema Json     @default("{}") @map("variables_schema")
  publishedAt    DateTime? @map("published_at")
  createdBy      String    @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")

  template       Template  @relation("TemplateVersions", fields: [templateId], references: [id], onDelete: Cascade)
  currentFor     Template? @relation("CurrentTemplateVersion")
  deliveries     Delivery[]

  @@unique([templateId, version])
  @@map("template_versions")
}

model Notification {
  id             String             @id
  userId         String             @map("user_id")
  source         Source
  eventType      String             @map("event_type")
  eventVersion   Int                @map("event_version")
  priority       Priority
  status         NotificationStatus @default(ACCEPTED)
  idempotencyKey String             @map("idempotency_key")
  requestHash    String             @map("request_hash")
  payload        Json
  policySnapshot Json?              @map("policy_snapshot")
  scheduledFor   DateTime?          @map("scheduled_for")
  traceId        String             @map("trace_id")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  events     NotificationEvent[]
  fanoutPlan FanoutPlan?
  deliveries Delivery[]
  inboxItems InboxItem[]
  campaignRecipients CampaignRecipient[]

  @@unique([userId, source, idempotencyKey], map: "notifications_idempotency_key")
  @@index([userId, createdAt(sort: Desc)], map: "notifications_user_created_idx")
  @@index([status, scheduledFor], map: "notifications_scheduler_idx")
  @@index([traceId])
  @@map("notifications")
}

model NotificationEvent {
  id             String   @id
  notificationId String   @map("notification_id")
  kind           String
  actor          String
  data           Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId, createdAt])
  @@map("notification_events")
}

model FanoutPlan {
  id             String   @id
  notificationId String   @unique @map("notification_id")
  policyHash     String   @map("policy_hash")
  policySnapshot Json     @map("policy_snapshot")
  channels       Json
  createdAt      DateTime @default(now()) @map("created_at")

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@map("fanout_plans")
}

model Delivery {
  id                String         @id
  notificationId    String         @map("notification_id")
  userId            String         @map("user_id")
  channel           Channel
  priority          Priority
  status            DeliveryStatus @default(PENDING)
  templateVersionId String?        @map("template_version_id")
  provider          String
  providerMessageId String?        @map("provider_message_id")
  attemptCount      Int            @default(0) @map("attempt_count")
  nextAttemptAt     DateTime?      @map("next_attempt_at")
  acceptedAt        DateTime?      @map("accepted_at")
  deliveredAt       DateTime?      @map("delivered_at")
  failedAt          DateTime?      @map("failed_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  notification   Notification      @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateVersion TemplateVersion? @relation(fields: [templateVersionId], references: [id])
  attempts       DeliveryAttempt[]
  retrySchedule  RetrySchedule?
  providerEvents ProviderEvent[]
  inboxItem      InboxItem?

  @@unique([notificationId, channel], map: "deliveries_notification_channel")
  @@index([status, nextAttemptAt], map: "deliveries_retry_idx")
  @@index([userId, createdAt(sort: Desc)])
  @@map("deliveries")
}

model DeliveryAttempt {
  id         String      @id
  deliveryId String      @map("delivery_id")
  attempt    Int
  provider   String
  requestId  String      @map("request_id")
  result     String
  errorClass ErrorClass? @map("error_class")
  errorCode  String?     @map("error_code")
  latencyMs  Int         @map("latency_ms")
  response   Json        @default("{}")
  createdAt  DateTime    @default(now()) @map("created_at")

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@unique([deliveryId, attempt])
  @@map("delivery_attempts")
}

model RetrySchedule {
  id         String     @id
  deliveryId String     @unique @map("delivery_id")
  channel    Channel
  dueAt      DateTime   @map("due_at")
  attempt    Int
  state      RetryState @default(PENDING)
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([state, dueAt], map: "retry_schedules_due_idx")
  @@map("retry_schedules")
}

model ProviderEvent {
  id             String   @id
  provider       String
  eventId        String   @map("event_id")
  deliveryId     String?  @map("delivery_id")
  type           String
  payload        Json
  signatureValid Boolean  @map("signature_valid")
  receivedAt     DateTime @default(now()) @map("received_at")

  delivery Delivery? @relation(fields: [deliveryId], references: [id])

  @@unique([provider, eventId])
  @@map("provider_events")
}

model InboxItem {
  id             String    @id
  userId         String    @map("user_id")
  notificationId String    @map("notification_id")
  deliveryId     String    @unique @map("delivery_id")
  source         Source
  title          String
  body           String
  deepLink       String?   @map("deep_link")
  metadata       Json      @default("{}")
  readAt         DateTime? @map("read_at")
  sequence       BigInt    @default(autoincrement())
  createdAt      DateTime  @default(now()) @map("created_at")
  expiresAt      DateTime? @map("expires_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  delivery     Delivery     @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationId], map: "inbox_items_user_notification")
  @@index([userId, sequence(sort: Desc)], map: "inbox_items_user_sequence_idx")
  @@index([userId, readAt], map: "inbox_items_unread_idx")
  @@map("inbox_items")
}

model Outbox {
  id            String       @id
  aggregateType String       @map("aggregate_type")
  aggregateId   String       @map("aggregate_id")
  shard         Int
  topic         String
  partitionKey  String       @map("partition_key")
  payload       Json
  headers       Json         @default("{}")
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now()) @map("available_at")
  publishedAt   DateTime?    @map("published_at")
  lastError     String?      @map("last_error")
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([status, availableAt, id], map: "outbox_claim_idx")
  @@index([publishedAt])
  @@map("outbox")
}

model Campaign {
  id           String         @id
  name         String
  templateId   String         @map("template_id")
  channel      Channel
  audience     Json
  payload      Json            @default("{}")
  scheduledFor DateTime?      @map("scheduled_for")
  rateLimit    Int            @default(50) @map("rate_limit")
  status       CampaignStatus @default(DRAFT)
  createdBy    String         @map("created_by")
  startedAt    DateTime?      @map("started_at")
  completedAt  DateTime?      @map("completed_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  template   Template             @relation(fields: [templateId], references: [id])
  recipients CampaignRecipient[]

  @@index([status, scheduledFor], map: "campaigns_scheduler_idx")
  @@map("campaigns")
}

model CampaignRecipient {
  campaignId     String                  @map("campaign_id")
  userId         String                  @map("user_id")
  shard          Int
  status         CampaignRecipientStatus @default(PENDING)
  notificationId String?                 @map("notification_id")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  campaign     Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification Notification? @relation(fields: [notificationId], references: [id])

  @@id([campaignId, userId])
  @@index([campaignId, status], map: "campaign_recipients_status_idx")
  @@map("campaign_recipients")
}

model JobRun {
  id         String    @id
  job        String
  shard      Int
  status     String
  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")
  error      String?
  metadata   Json      @default("{}")

  @@index([job, shard, startedAt(sort: Desc)])
  @@map("job_runs")
}

model AuditLog {
  id           String      @id
  actorKeyId   String?     @map("actor_key_id")
  actorLabel   String      @map("actor_label")
  action       String
  resourceType String      @map("resource_type")
  resourceId   String?     @map("resource_id")
  result       AuditResult
  traceId      String      @map("trace_id")
  metadata     Json        @default("{}")
  createdAt    DateTime    @default(now()) @map("created_at")

  @@index([actorKeyId, createdAt(sort: Desc)])
  @@index([resourceType, resourceId])
  @@map("audit_log")
}

model DeadLetter {
  id           String     @id
  topic        String
  partition    Int?
  offset       BigInt?
  deliveryId   String?    @map("delivery_id")
  notificationId String?  @map("notification_id")
  payload      Json
  headers      Json       @default("{}")
  attempts     Int
  errorClass   ErrorClass @map("error_class")
  errorCode    String?    @map("error_code")
  createdAt    DateTime   @default(now()) @map("created_at")
  replayedAt   DateTime?  @map("replayed_at")
  discardedAt  DateTime?  @map("discarded_at")
  discardReason String?   @map("discard_reason")

  @@index([createdAt(sort: Desc)])
  @@index([topic, createdAt])
  @@map("dead_letters")
}

model ProviderFault {
  id        String   @id
  provider  String
  channel   Channel
  outcome   String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([provider, channel])
  @@map("provider_faults")
}
