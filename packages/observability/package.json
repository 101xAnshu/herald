{
  "name": "@herald/observability",
  "version": "0.1.0",
  "private": true,
  "description": "Logging, metrics, and trace helpers",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
