{
  "name": "herald",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "description": "Multi-channel notification platform",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/101xAnshu/herald.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "./scripts/test-integration.sh",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @herald/db prisma:generate",
    "db:migrate": "pnpm --filter @herald/db prisma:migrate",
    "db:seed": "pnpm --filter @herald/db prisma:seed",
    "herald": "tsx apps/cli/src/index.ts",
    "herald:build": "pnpm --filter @herald/cli build",
    "worker:dev": "pnpm --filter @herald/worker dev",
    "api:dev": "pnpm --filter @herald/api dev",
    "test:e2e": "tsx scripts/smoke.ts",
    "bench": "tsx scripts/bench.ts",
    "drill:db": "./scripts/drill-db.sh",
    "site": "python3 -m http.server 8080 --directory site",
    "bench:http": "tsx scripts/bench-http.ts",
    "scenario:timeout": "tsx scripts/scenario-timeout.ts",
    "scenario:kill": "tsx scripts/scenario-kill.ts"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/node": "^26.6.6",
    "autocannon": "^8.0.0",
    "dotenv": "^18.0.9",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
