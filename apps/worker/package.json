{
  "name": "@herald/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Background workers",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@herald/cache": "workspace:*",
    "@herald/config": "workspace:*",
    "@herald/contracts": "workspace:*",
    "@herald/core": "workspace:*",
    "@herald/db": "workspace:*",
    "@herald/observability": "workspace:*",
    "@herald/providers": "workspace:*",
    "@herald/queue": "workspace:*"
  }
}
