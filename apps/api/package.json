{
  "name": "@herald/api",
  "version": "0.1.0",
  "private": true,
  "description": "HTTP API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run --passWithNoTests",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@herald/cache": "workspace:*",
    "@herald/config": "workspace:*",
    "@herald/contracts": "workspace:*",
    "@herald/core": "workspace:*",
    "@herald/db": "workspace:*",
    "@herald/observability": "workspace:*",
    "@herald/queue": "workspace:*",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1"
  }
}
